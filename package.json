{
  "name": "akmal-alif-master",
  "version": "1.0.0",
  "description": "Personal portfolio website",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.21.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "dev:worker": "wrangler dev",
    "dev:admin": "pnpm --dir apps/admin dev",
    "dev:judging": "pnpm --dir apps/judging-local dev",
    "build:admin": "pnpm --dir apps/admin build",
    "test:admin": "pnpm --dir apps/admin test --run",
    "check:admin": "pnpm --dir apps/admin types:check && pnpm --dir apps/admin lint",
    "test": "node --test test/*.test.js",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^5.4.11",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "three": "0.170.0"
  }
}

# The Vite frontend forwards public GET/HEAD requests only.
PORTFOLIO_DEV_BACKEND=https://www.akmalalif.com
# To read a local Worker instead, use http://localhost:8787 in .env.local.

# The portfolio Worker owns admin authentication. Keep real values in root .env.
BETTER_AUTH_URL=https://www.akmalalif.com
ADMIN_GITHUB_ID=44127834
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Account observability reads only. Upload as an encrypted admin Worker secret.
CF_OBSERVABILITY_TOKEN=

{
  "name": "@akmal-alif/admin",
  "type": "module",
  "version": "0.3.1",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "nuxt dev --port 7466",
    "analyze": "nuxt analyze",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:security": "vitest run --config tests/vitest.security.config.ts",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:all": "pnpm build && pnpm test && pnpm test:security && pnpm test:worker",
    "prebuild": "pnpm build:assets",
    "build": "nuxt build",
    "build:assets": "pnpm build:map && pnpm build:sphere",
    "build:map": "node scripts/build-map.js",
    "build:sphere": "node scripts/build-sphere.js",
    "build:colo": "node scripts/build-colo.js",
    "build:testimonials": "node scripts/build-testimonials.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "locales:check": "node scripts/check-locales.js",
    "types:check": "nuxt typecheck",
    "wrangler": "wrangler",
    "gen:types": "wrangler types --env-file .env.example",
    "deploy:config": "node scripts/cloudflare-deploy-config.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:migrate:remote": "pnpm deploy:config && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
    "deploy": "pnpm deploy:worker",
    "deploy:pages": "wrangler pages deploy dist",
    "deploy:worker": "wrangler deploy .output/server/index.mjs --assets .output/public --config wrangler.jsonc",
    "preview": "wrangler dev .output/server/index.mjs --assets .output/public",
    "preview:worker:local": "wrangler dev .output/server/index.mjs --assets .output/public --config wrangler.local.jsonc --local --port 8788",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.24.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@number-flow/vue": "^0.5.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.4.1",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/vue-form": "^1.33.1",
    "@tanstack/vue-table": "^8.21.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/topojson-client": "^3.1.5",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "destr": "^2.0.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-vue": "^8.6.0",
    "es-toolkit": "^1.49.0",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-format": "^2.0.1",
    "h3": "^1.15.11",
    "intl-parse-accept-language": "^1.0.0",
    "jose": "^6.2.3",
    "jsonc-parser": "^3.3.1",
    "kysely": "0.29.3",
    "nanoid": "^5.1.16",
    "nitropack": "^2.13.4",
    "nuxt": "^4.4.7",
    "pinia": "^3.0.4",
    "qr-code-styling": "^1.9.2",
    "reka-ui": "^2.10.2",
    "shadcn-nuxt": "^2.7.4",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "twgl.js": "^7.0.0",
    "typescript": "^5.9.3",
    "ua-parser-js": "^2.0.10",
    "ufo": "^1.6.4",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "virtua": "^0.49.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.7",
    "vue3-simple-icons": "^16.10.0",
    "wrangler": "^4.110.0",
    "zod": "^4.4.3"
  }
}

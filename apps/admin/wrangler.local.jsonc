{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akmalalif-admin-local",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akmalalif-admin-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "PORTFOLIO_ADMIN_ORIGIN": "http://localhost:8788",
    "SHORTLINK_ORIGIN": "http://localhost:8788",
    "ADMIN_EMAIL": "iamaleep@gmail.com",
    "ALLOW_LOCAL_ADMIN": "true",
    "NUXT_PUBLIC_PREVIEW_MODE": "false",
    "NUXT_SITE_TOKEN": "local-only-site-token",
    "NUXT_API_CORS": "false"
  }
}

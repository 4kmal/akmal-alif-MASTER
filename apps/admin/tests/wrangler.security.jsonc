{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "akmalalif-admin-test",
  "main": "worker-entry.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akmalalif-admin-test",
      "database_id": "test-db",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "test-kv"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "akmalalif-admin-test"
    }
  ],
  "vars": {
    "PORTFOLIO_ADMIN_ORIGIN": "http://portfolio.test",
    "SHORTLINK_ORIGIN": "http://go.test",
    "ADMIN_EMAIL": "owner@example.test"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akmalalif-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "73138007ecb740aea99f9c99bb2a2705",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ADMIN_EMAIL": "iamaleep@gmail.com",
    "ADMIN_GITHUB_ID": "44127834",
    "BETTER_AUTH_URL": "https://www.akmalalif.com",
    "ADMIN_AUTH_MODE": "better-auth",
    "PORTFOLIO_ADMIN_ORIGIN": "https://www.akmalalif.com"
  },
  "services": [
    { "binding": "ADMIN", "service": "akmalalif-admin" }
  ],
  "ratelimits": [
    {
      "name": "EVENT_RATE_LIMITER",
      "namespace_id": "74102601",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "www.akmalalif.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akmalalif-portfolio",
      "database_id": "675ccbd5-f4aa-4ad6-b292-0d8fac7c54d5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "akmalalif-portfolio-media"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
